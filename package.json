{
  "name": "@cocreate/editor",
  "version": "1.0.0",
  "description": "Extensible collaborative editor for text, HTML/DOM, Markdown, and code with syntax highlighting and optional CRDT sync.",
  "keywords": [
    "cocreate",
    "editor",
    "text",
    "code",
    "editor-framework",
    "extensible",
    "parser",
    "rendering",
    "crdt",
    "syntax-highlighting",
    "html",
    "markdown"
  ],
  "browser": "./src/index.js",
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Extensible collaborative editor for text, HTML/DOM, Markdown, and code with syntax highlighting and optional CRDT sync.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          "code",
          ":is([editor], [contenteditable], input[crdt='true'], textarea[crdt='true']):not([contenteditable='false']):not([editor-query])",
          "[editor-query], [editor-attribute], [editor-property]",
          "${editorSelector}, ${bindingSelector}",
          "code[language]"
        ],
        "attributes": [
          {
            "name": "contenteditable"
          },
          {
            "name": "crdt"
          },
          {
            "name": "editor"
          },
          {
            "name": "editor-attribute"
          },
          {
            "name": "editor-property"
          },
          {
            "name": "editor-query"
          },
          {
            "name": "language"
          }
        ]
      },
      "api": {
        "exports": [
          "autoLanguageDetection",
          "bindEditorInput",
          "createCodeEditor",
          "createCore",
          "createDOMEditor",
          "createEditorCore",
          "createEditorEvents",
          "createMarkdownEditor",
          "createTextEditor",
          "deleteStoredEditorDetails",
          "destroyEditor",
          "getSelection",
          "getStoredEditorDetails",
          "init",
          "initEditorInput",
          "initEditorQuery",
          "initElement",
          "initElements",
          "initLanguage",
          "lengthEditorDetails",
          "loadEditor",
          "loadParser",
          "parseAndStoreCodeDetails",
          "parseAndStoreEditorDetails",
          "parseAndStoreMarkdownDetails",
          "parseCode",
          "parseDOM",
          "parseMarkdown",
          "sendPosition",
          "setSelection",
          "textChange",
          "uninitEditorInput",
          "uninitEditorQuery",
          "updateElement",
          "updateStoredEditorDetails",
          "updateText"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "test": "node --test test/*.cjs"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "homepage": "https://CoCreateJS.com/docs/editor",
  "funding": {
    "type": "GitHub Sponsors \u2764",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/element-prototype": "^1.35.0",
    "@cocreate/observer": "^1.23.0",
    "@cocreate/crdt": "^1.34.0",
    "@cocreate/utils": "^1.57.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.8.0",
    "playwright-core": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-editor.git"
  },
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-editor/issues"
  }
}
