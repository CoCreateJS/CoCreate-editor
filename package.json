{
  "name": "@cocreate/editor",
  "version": "1.0.0",
  "description": "Extensible collaborative editor for text, HTML/DOM, Markdown, and code with syntax highlighting and optional CRDT sync.",
  "keywords": [
    "cocreate",
    "editor",
    "text",
    "code",
    "editor-framework",
    "extensible",
    "parser",
    "rendering",
    "crdt",
    "syntax-highlighting",
    "html",
    "markdown"
  ],
  "browser": "./src/index.js",
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "test": "node --test test/*.cjs"
  },
